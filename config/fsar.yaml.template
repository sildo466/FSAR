# FSAR unified configuration — copy to fsar.yaml and edit.

onboarding:
  completed: false
  completed_at: null
  completed_steps: []
  started_at: null
  last_step: null

llm:
  active: ""
  providers: []
embedder:
  provider: ""
  base_url: ""
  model: ""
  timeout: 60
memory:
  sqlite_path: data/memory.db
  short_term_window: 50
  chroma_path: data/chroma
  reflection_interval_hours: 12
  reflection_intensity: medium
  recall_max_chars: 2000
  enable_rating_prompt: true
llm_cache:
  enabled: true
  db_path: data/llm_cache.db
  l1_max_entries: 256
  l1_ttl_seconds: 300
  l2_ttl_seconds: 86400
  retention: short
  skip_vision: true
  use_responses_api: true
gui:
  host: 127.0.0.1
  port: 8765
logging:
  level: INFO
  file: data/logs/fsar_{time:YYYY-MM-DD}.log
permissions:
  mode: normal
  tools: {}
  path_rules: []
mcp:
  servers: []
reflection:
  intensity: medium
  triggers:
    per_task: true
    on_failure: true
    idle_batch:
      enabled: false
      threshold_events: 20
      threshold_hours: 12
user:
  display_name: ""
style:
  theme: system
  font_scale: 1.0
  density: comfortable
  motion: subtle
  per_page_overrides: {}
plugins: []
external_skills: []
