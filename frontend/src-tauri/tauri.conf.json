{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FSAR",
  "version": "0.1.0",
  "identifier": "ai.fsar.gui",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8765",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FSAR",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
